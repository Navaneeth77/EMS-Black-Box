<?xml version='1.0' encoding='UTF-8'?>

<!--
  EMS Black Box - netconvert configuration for the Silk Board study area.

  Generated by ems_sim.network.sumo_convert. COMMITTED as an input: this
  file is the recipe that makes the conversion reproducible. Rerun with

      $SUMO_HOME/bin/netconvert -c silk_board_v1.netccfg

  The 'flatten' option must never appear here. It removes all z-data
  and would collapse the flyover into the ground network. (Written
  without its leading dashes because XML comments cannot contain them.)
-->

<configuration>
    <input>
        <osm-files value="../../../data/raw/silk_board_v1/silk_board_v1.osm.xml"/>
    </input>

    <output>
        <output-file value="silk_board_v1.net.xml"/>
    </output>

    <processing>
        <geometry.remove value="true"/>
        <junctions.corner-detail value="5"/>
        <junctions.join value="true"/>
        <junctions.join-dist value="15"/>
        <junctions.join-output value="silk_board_v1.net.joined-junctions.xml"/>
        <keep-edges.by-vclass value="passenger"/>
        <keep-edges.components value="1"/>
        <keep-edges.in-geo-boundary value="77.615889,12.910001,77.630635,12.924471"/>
        <osm.annotate-defaults value="true"/>
        <osm.turn-lanes value="true"/>
        <output.original-names value="true"/>
        <output.street-names value="true"/>
        <proj.utm value="true"/>
        <seed value="42"/>
        <tls.default-type value="static"/>
        <tls.guess-signals value="true"/>
        <tls.guess-signals.dist value="30"/>
        <tls.join value="true"/>
        <tls.join-dist value="60"/>
        <verbose value="true"/>
    </processing>
</configuration>
