# EMS Black Box - root ignore rules
# Covers: Python, Node, SUMO artefacts, macOS, editors, local data
# ---------------------------------------------------------------------------

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
.python-version

# Testing / typing / linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# Jupyter
.ipynb_checkpoints/

# --- Node / frontend ------------------------------------------------------
node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.eslintcache
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.local

# --- SUMO -----------------------------------------------------------------
# Generated networks, routes and outputs are reproducible from configs + seeds,
# so they are rebuilt rather than committed. Hand-authored scenario *inputs*
# (.sumocfg, additional files, policy definitions) ARE committed.
*.net.xml
*.net.xml.gz
*.rou.xml
*.rou.alt.xml
*.trips.xml
*.poly.xml
# NOTE: .netccfg is NOT ignored. The netconvert configuration is a committed
# INPUT - the recipe that makes the conversion reproducible - not an output.
# Only the artefacts it generates are regenerable.
*.netecfg
sumo-gui.log
sumo.log

# netconvert artefacts are regenerated with the network. Only the .netccfg —
# the recipe — is committed; everything netconvert produces from it is output,
# and several of these embed absolute paths from the machine that ran them.
*.netconvert.log
*.netconvert.err
simulation/sumo/**/*.validation.json
simulation/sumo/**/*.warnings.json
simulation/sumo/**/*.joined-junctions.xml

# Phase 3 generated demand, routes, scenario configs and run outputs. All are
# regenerable from the committed demand configuration plus the recorded seed;
# what gets committed is the recipe, not the output.
simulation/demand/*.flows.xml
simulation/routes/*.rou.xml
simulation/routes/*.rou.alt.xml
simulation/config/*.sumocfg
simulation/results/**
!simulation/results/.gitkeep
!simulation/results/README.md

# SUMO simulation outputs (regenerate from saved config + seed)
*.tripinfo.xml
*.fcd.xml
*.summary.xml
*.emissions.xml
*.queue.xml
*.edgedata.xml
*.lanedata.xml
*.vehroutes.xml
*.stopinfo.xml
*.statistics.xml

# --- Data -----------------------------------------------------------------
# Large / derived data stays out of git. Provenance records DO get committed:
# they are the audit trail describing what the ignored files contain.
data/raw/**
!data/raw/.gitkeep
!data/raw/README.md
data/processed/**
!data/processed/.gitkeep
!data/processed/README.md
!data/provenance/**

# Phase 4 calibration outputs. Committed: they are small (~0.7 MB), they carry
# the provenance and configuration hashes for every run, and they are the
# evidence behind the uncertainty and sensitivity claims in the docs.
#
# Git cannot re-include a path through an excluded parent, so the intermediate
# directories have to be un-excluded first.
!data/processed/*/
!data/processed/*/calibration/
!data/processed/*/calibration/**
!data/processed/*/baseline_runs/
!data/processed/*/baseline_runs/**
!data/processed/*/ems/
!data/processed/*/ems/**
!data/processed/*/counterfactual/
!data/processed/*/counterfactual/**

# Phase 5a control outputs. Committed for the same reason as the counterfactual
# ones: the control is the evidence that the traffic-side effect is not caused by
# the ambulance, and that claim should not rest on a file nobody can see.
!data/processed/*/control/
!data/processed/*/control/**

# Phase 5b speed-sensitivity outputs. Committed because the headline result rests
# on one edge whose speed is a netconvert default, and the evidence that the
# finding survives a more conservative assumption should be inspectable.
!data/processed/*/sensitivity/
!data/processed/*/sensitivity/**

# The aggregate results and validation reports every headline number is quoted
# from. These were excluded by the `data/processed/**` rule above while their
# *inputs* were committed, which is the wrong way round: a reader could see the
# 20 per-run files but not the analysis that reduces them, and a fresh clone had
# no way to check a single figure in FINAL_RESULTS.md without re-running the
# whole matrix. Small (~1.4 MB in total) and derived, but derived evidence is
# still the evidence.
!data/processed/*/*.json
!data/processed/historical_demo/
!data/processed/historical_demo/**

# Geometry the visualisation and the trip rule read. Small, and the elevation
# layer index in particular is an input to a committed decision (which routes are
# rejected for sharing ground), so it has to be inspectable.
!data/processed/*/*.geojson

# Still excluded, deliberately, with the reason:
#   *.gpkg              3.5 MB binary, regenerated by scripts/ingest_study_area.py
#   simulation/results  3.3 GB of SUMO output; tripinfo/queues/FCD are reproduced
#                       by re-running, and the per-run JSON records what they said
#   simulation/routes   204 MB of generated demand; regenerated byte-identically
#                       from the demand config and seed, which is what the
#                       determinism check verifies
#   frontend/public/scene  60 MB of exported scene payload, regenerated by
#                       scripts/export_scene.py
data/processed/**/*.gpkg

# Simulation run outputs
runs/
outputs/
*.sqlite
*.duckdb

# --- Docker / database ----------------------------------------------------
docker/volumes/
pgdata/

