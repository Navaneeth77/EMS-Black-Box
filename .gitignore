!.vscode/settings.example.json
.idea/
*.swp
*.swo
*~

# --- Secrets / local config ----------------------------------------------
.env
.env.*
!.env.example

# Exported 3D scene payload. Derived data, regenerated by
# `python scripts/export_scene.py`. The manifest records the network hash, seed
# and policy it came from, so a scene can always be traced back to its run.
#
# The HISTORICAL_DEMO scene is the exception and IS committed (27 MB). The
# frontend is a renderer of a recording: deployed without its recording it
# loads nothing and shows a fetch error, so the hosted build needs the payload
# in the repository. Only the default scene is kept — the paired NORMAL run
# included, because COMPARE fetches it lazily and the button is otherwise dead.
# The earlier `?scene=demo` export (33 MB) stays out; it is superseded.
#
# The exclusion is written per-entry rather than on the directory: git cannot
# re-include anything inside a directory it has already excluded.
frontend/public/scene/*
!frontend/public/scene/historical
