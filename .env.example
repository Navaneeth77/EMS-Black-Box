# Copy to .env and adjust. .env is git-ignored.

# --- Backend --------------------------------------------------------------
EMS_API_HOST=127.0.0.1
EMS_API_PORT=8000
EMS_LOG_LEVEL=info

# Origins allowed to call the API from a browser (comma-separated).
EMS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- SUMO -----------------------------------------------------------------
# On this machine SUMO is installed as a macOS Framework bundle, so SUMO_HOME
# is NOT set by the installer and the `sumo` on PATH is the GUI launcher.
# See docs/ENVIRONMENT.md. Leave blank to let auto-detection run.
SUMO_HOME=/Library/Frameworks/EclipseSUMO.framework/Versions/Current/EclipseSUMO/share/sumo

# --- Database (optional; nothing depends on it yet) -----------------------
EMS_DATABASE_URL=postgresql://ems:ems_local_dev@localhost:5433/ems_black_box
